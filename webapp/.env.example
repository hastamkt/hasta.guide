# Banco de dados (Postgres em produção; pode usar SQLite local trocando o provider no schema.prisma)
DATABASE_URL="postgresql://user:password@host:5432/iaparaleigos"

# NextAuth
NEXTAUTH_URL="https://iaparaleigos.hastamarketing.com"
NEXTAUTH_SECRET="gere com: openssl rand -base64 32"

# Login com Google (console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Stripe (dashboard.stripe.com -> Developers -> API keys)
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
# Developers -> Webhooks -> cria endpoint apontando pra /api/webhooks/stripe, copia o signing secret
STRIPE_WEBHOOK_SECRET=""
# Price ID do plano mensal (recorrente, intervalo "month")
STRIPE_PRICE_MONTHLY=""
# Price ID do plano anual (recorrente, intervalo "year" — SEM parcelamento, Stripe não parcela assinatura)
STRIPE_PRICE_ANNUAL=""

# Email que tem acesso ao painel /admin (cadastro de cupons/afiliados e relatório de comissão)
ADMIN_EMAIL=""
